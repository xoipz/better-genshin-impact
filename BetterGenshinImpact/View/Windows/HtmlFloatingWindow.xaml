<Window x:Class="BetterGenshinImpact.View.Windows.HtmlFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BetterGI HTML Panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Width="400" Height="300"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">
    
    <Window.Resources>
        <Storyboard x:Key="ShowTitleBar">
            <DoubleAnimation Storyboard.TargetName="TitleBarBorder"
                           Storyboard.TargetProperty="Opacity"
                           To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="HideTitleBar">
            <DoubleAnimation Storyboard.TargetName="TitleBarBorder"
                           Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="WindowFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="WindowFadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="LockButtonFadeIn">
            <DoubleAnimation Storyboard.TargetName="LockButton"
                           Storyboard.TargetProperty="Opacity"
                           To="1.0" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="LockButtonFadeOut">
            <DoubleAnimation Storyboard.TargetName="LockButton"
                           Storyboard.TargetProperty="Opacity"
                           To="0.1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <!-- 按钮样式 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border x:Name="ContainerBorder"
            Background="#01000000"
            CornerRadius="8"
            BorderBrush="#60FFFFFF"
            BorderThickness="1">
        <Grid>
            <!-- 标题栏 (默认隐藏，hover显示) -->
            <Border x:Name="TitleBarBorder"
                    Panel.ZIndex="10"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="#CC1a1a1a"
                    CornerRadius="8,8,0,0"
                    Opacity="0"
                    MouseLeftButtonDown="OnTitleBarMouseDown"
                    MouseMove="OnTitleBarMouseMove"
                    MouseLeftButtonUp="OnTitleBarMouseUp"
                    MouseEnter="OnTitleBarMouseEnter"
                    MouseLeave="OnTitleBarMouseLeave">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 标题文本 -->
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               Text="HTML Panel"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"/>
                    
                    <!-- 控制按钮 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,4,0">
                        <!-- 锁定/解锁按钮 -->
                        <Button x:Name="LockButton"
                                Width="28" Height="28"
                                Content="🔓"
                                FontSize="14"
                                Click="OnLockClick"
                                ToolTip="点击启用穿透"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- WebView2容器 (标题栏覆盖在上方) -->
            <Border Margin="0"
                    CornerRadius="8"
                    ClipToBounds="True">
                <wv2:WebView2 x:Name="WebView"
                              DefaultBackgroundColor="Transparent"/>
            </Border>
        </Grid>
    </Border>
</Window>
